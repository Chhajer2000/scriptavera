    given-names: "Vaibhav"
version: 1.0
date-released: 2026-10-10
license: AGPL-3.0-only
keywords:
  - "research notes"
  - "handwriting"
  - "LaTeX"
  - "scientific writing"
  - "mathematics"
  - "open science"
